<UserControl x:Class="NewStarTicket.Views.UserRightsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NewStarTicket.Views"
             mc:Ignorable="d" 
             d:DesignHeight="570" d:DesignWidth="1025">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Top"
                    Grid.Row="0">
            <TextBox Text="Rechercher ..."
                     Width="300"
                     Height="30"/>
            <Button Name="searchButton"
                    Content="Chercher"
                    Margin="5,0,0,0"/>
        </StackPanel>


        <DataGrid ItemsSource="{Binding CurrentUserList}" 
                  AutoGenerateColumns="False" 
                  HeadersVisibility="Column" 
                  CanUserAddRows="False" 
                  GridLinesVisibility="Horizontal" 
                  Grid.Row="1"
                  FontFamily="Palatino Linotype"
                  VerticalAlignment="Stretch"
                  HorizontalAlignment="Stretch">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID Utilisateur" 
                                    Binding="{Binding IdUser}" 
                                    Width="250"/>
                <DataGridTextColumn Header="Nom" 
                                    Binding="{Binding NameUser}" 
                                    Width="*"/>
                <DataGridTextColumn Header="Mail" 
                                    Binding="{Binding EmailUser}" 
                                    Width="240"/>
                <DataGridTextColumn Header="Niveau" 
                                    Binding="{Binding UserIdLevel}" 
                                    Width="50"/>
                <DataGridTemplateColumn Header="Infos" 
                                        Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Voir" 
                                        Command="{Binding DataContext.ShowUserInfosCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" 
                                        Width="60"/>
                            </StackPanel>

                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Etat utilisateur" 
                                        Width="100"
                                        Visibility="{Binding AdminColumnVisibility}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Button Content="Modifier" 
                                        Background="LightBlue" 
                                        Command="{Binding DataContext.EditUserInfosCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                        CommandParameter="{Binding}" 
                                        Width="100" 
                                        Margin="0,2"/>
                                <Button Content="Supprimer" 
                                        Background="Red" 
                                        Foreground="White" 
                                        Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                        CommandParameter="{Binding}" 
                                        Width="75"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
